renderCatalog([{ id: 100, title: "<i>Тест</i>", author: "Автор", year: 2026, genre: "Роман", available: true, rating: 5 }]);

// 2.5.B
function createRowB(book) {
  const tr = createRow(book);
  const ratingCell = tr.querySelector(".rating");
  const rating = book.rating || 0;
  
  const stars = "★".repeat(Math.floor(rating)) + "☆".repeat(5 - Math.floor(rating));
  ratingCell.textContent = stars;
  ratingCell.dataset.value = rating;
  
  if (rating >= 4.7) ratingCell.classList.add("top");
  return tr;
}

function renderCatalogB(list) {
  const tbody = document.querySelector("#books tbody");
  tbody.replaceChildren(...list.map(createRowB));
}
// Проверка:
