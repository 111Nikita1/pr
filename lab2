// 2.5.A
function createRow(book) {
  const tr = document.createElement("tr");
  tr.className = "book";
  tr.dataset.id = book.id;
  tr.dataset.genre = book.genre;
  tr.dataset.available = book.available;
  
  tr.innerHTML = `
    <td class="title"></td>
    <td class="author"></td>
    <td class="year"></td>
    <td class="genre"></td>
    <td class="rating"></td>
    <td><button class="take" type="button"></button></td>
  `;
  
  // textContent защищает от XSS (теги вроде <i> выводятся как текст)
  tr.querySelector(".title").textContent = book.title;
  tr.querySelector(".author").textContent = book.author;
  tr.querySelector(".year").textContent = book.year;
  tr.querySelector(".genre").textContent = book.genre;
  tr.querySelector(".rating").textContent = book.rating;
  
  const btn = tr.querySelector(".take");
  btn.textContent = book.available ? "Взять" : "Выдана";
  btn.disabled = !book.available;
  
  return tr;
}

function renderCatalog(list) {
  const tbody = document.querySelector("#books tbody");
  tbody.replaceChildren(...list.map(createRow));
}

renderCatalog(books);
renderCatalog(books.filter(b => b.available));
renderCatalog(books.filter(b => b.genre === "Роман"));
renderCatalog([...books].sort((a, b) => b.year - a.year));
