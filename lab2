// 2.6.B
function renderHistory(userId) {
  const myList = document.getElementById("my-list");
  
  const oldH3 = document.querySelector("h3:has(+ #history)");
  if (oldH3) oldH3.nextElementSibling.remove(), oldH3.remove();

  const h3 = document.createElement("h3");
  h3.textContent = "История";
  const ul = document.createElement("ul");
  ul.id = "history";

  myList.after(h3, ul);

  const returnedLoans = loans.filter(l => l.userId === userId && l.returnedAt !== null);
  
  const items = returnedLoans.map(l => {
    const book = books.find(b => b.id === l.bookId);
    const li = document.createElement("li");
    const rating = l.rating || 0;
    const stars = "★".repeat(rating) + "☆".repeat(5 - rating);
    li.textContent = `${book.title} — ${stars}`;
    return li;
  });

  ul.replaceChildren(...items);
}
renderHistory(1);
