function castTypes(obj) {
  const result = {};
  for (const key in obj) {
    let val = obj[key];
    if (val === "true") val = true;
    else if (val === "false") val = false;
    else if (!isNaN(val) && val.trim() !== "") val = Number(val);
    result[key] = val;
  }
  return result;
}
